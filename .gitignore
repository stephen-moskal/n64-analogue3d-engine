# Build artifacts
build/
*.z64
*.elf
*.dfs
*.o
*.d
*.sym
*.map
*.stripped

# Generated assets — rebuilt by `make` from assets/ with the container's
# mksprite/audioconv64. Their binary format is tied to the libdragon version,
# so committing them causes "invalid version" asserts on other machines.
filesystem/*.sprite
filesystem/audio/

# libdragon submodule working tree (the gitlink itself stays tracked)
libdragon/

# Editor
.vscode/c_cpp_properties.json
*.code-workspace

# System
.DS_Store
Thumbs.db

# Emulator saves, debug logs
*.pak
*.log
__pycache__/
