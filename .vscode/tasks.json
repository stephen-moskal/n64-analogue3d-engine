{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ROM (debug)",
            "type": "shell",
            "command": "libdragon make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build ROM (release)",
            "type": "shell",
            "command": "libdragon make BUILD=release",
            "group": "build",
            "problemMatcher": {
                "owner": "c",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "libdragon make clean",
            "problemMatcher": []
        },
        {
            "label": "Rebuild",
            "dependsOrder": "sequential",
            "dependsOn": ["Clean Build", "Build ROM (debug)"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run in ares (debug)",
            "type": "shell",
            "command": "open -a ares \"${workspaceFolder}/engine-debug.z64\"",
            "windows": {
                "command": "ares \"${workspaceFolder}/engine-debug.z64\""
            },
            "dependsOn": "Build ROM (debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Run in ares (release)",
            "type": "shell",
            "command": "open -a ares \"${workspaceFolder}/engine.z64\"",
            "windows": {
                "command": "ares \"${workspaceFolder}/engine.z64\""
            },
            "dependsOn": "Build ROM (release)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Upload to SummerCart64 (debug)",
            "type": "shell",
            "command": "sc64deployer upload \"${workspaceFolder}/engine-debug.z64\"",
            "dependsOn": "Build ROM (debug)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Upload to SummerCart64 (release)",
            "type": "shell",
            "command": "sc64deployer upload \"${workspaceFolder}/engine.z64\"",
            "dependsOn": "Build ROM (release)",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Debug (USB Log)",
            "type": "shell",
            "command": "sc64deployer debug",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
